{
  "name": "backyard-golf",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "One-handed, call-your-own-hole neighborhood golf.",
  "scripts": {
    "serve": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --project tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "start:server": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.cjs && npm run test:server",
    "test:server": "npm run build:server && node --test server/index.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "0.128.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^22.1.0",
    "three": "0.128.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
